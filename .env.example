# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Microsoft Clarity
VITE_CLARITY_PROJECT_ID=your-clarity-project-id

# Email API (Render-hosted server)
VITE_EMAIL_API_URL=https://your-email-server.onrender.com
VITE_EMAIL_API_KEY=your-api-key

# Web Push (VAPID) — generate keys: npx web-push generate-vapid-keys
# Public key goes here; private key goes in Supabase Edge Function secrets as VAPID_PRIVATE_KEY
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
